{
  "name": "dsh-code-search",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin: code retrieval tool code_search (tantivy BM25 + jieba + embedded ast-grep) so the agent searches existing code before writing new implementations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vesita/code-search.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "bin/code-search",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node selfcheck.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
