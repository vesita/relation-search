{
  "name": "dsh-relation-search",
  "version": "0.2.11",
  "description": "DeepSeek Harness plugin: code retrieval tool relation_search (tantivy BM25 + jieba + embedded ast-grep) so the agent searches existing code before writing new implementations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vesita/relation-search.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "bin/relation-search",
    "README.md"
  ],
  "bin": {
    "relation-search": "./bin/relation-search"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node selfcheck.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
